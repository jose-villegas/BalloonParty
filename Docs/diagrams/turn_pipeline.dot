digraph SpawnPipeline {
    rankdir=TB;
    bgcolor="transparent";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box];
    edge [fontname="Helvetica", fontsize=8];

    // Phases
    Hit [label="Hit (any time a ball flies)\n─────────\nProjectile bounces\nPops/deflects balloons\nNeighbors nudge", fillcolor="#3d2a1a", fontcolor="#f78166"];
    Balance [label="Pre-line Balance\n─────────\nBalance() consolidates\nexisting balloons upward\nTransit slots reserved\nin BalancePathHolder", fillcolor="#1f3a5f", fontcolor="#58a6ff"];
    Spawn [label="Spawn one line\n─────────\nSpawnLine(), synchronous\nComputePath checks\nBalancePathHolder", fillcolor="#1a3a1a", fontcolor="#3fb950"];
    PostBalance [label="Post-line Balance\n─────────\nDeferred balance pass\n(next frame)\nBalanceBalloonsMessage", fillcolor="#2d1f3d", fontcolor="#d2a8ff"];
    Pulse [label="Rebalance pulse\n─────────\nEvery FlightRebalanceInterval\nall through play", fillcolor="#1f3a5f", fontcolor="#58a6ff"];

    // Triggers
    Clock [label="SpawnClock\nOne line per interval of scaled time\n(held while paused / level-up / lone doomed ball)", fillcolor="#2a2a2a", fontcolor="#8b949e", shape=ellipse];
    LineMsg [label="SpawnBalloonLineMessage(1)", fillcolor="#2a2a2a", fontcolor="#8b949e", shape=ellipse];
    BalanceMsg [label="BalanceBalloonsMessage", fillcolor="#2a2a2a", fontcolor="#8b949e", shape=ellipse];

    Clock -> LineMsg [color="#3fb950"];
    LineMsg -> Balance [color="#58a6ff"];
    Balance -> Spawn [label="grid updated", color="#3fb950", fontcolor="#8b949e"];
    Spawn -> BalanceMsg [color="#d2a8ff"];
    BalanceMsg -> PostBalance [color="#d2a8ff"];
    Hit -> Pulse [label="board changes", style=dashed, color="#f78166", fontcolor="#8b949e"];
}
